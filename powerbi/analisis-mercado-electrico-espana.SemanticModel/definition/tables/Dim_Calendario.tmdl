	column Evento = "Fecha"
		lineageTag: 3fc2025a-6e4c-4e67-b27a-8cc0e34d3a30
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column SemanaDelMes = ```
			
			VAR PrimerDiaMes = STARTOFMONTH(Dim_Calendario[Fecha])
			VAR PrimerLunes = PrimerDiaMes - WEEKDAY(PrimerDiaMes, 2) + 1
			RETURN 
			INT(
			    (Dim_Calendario[Fecha] - PrimerLunes) / 7
			) + 1
			```
		formatString: 0
		lineageTag: 5a442af8-d22f-4943-bda5-bd5e5dd8ac00
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column InicioSemana = ```
			
			Dim_Calendario[Fecha] 
			- WEEKDAY(Dim_Calendario[Fecha], 2) + 1
			```
		formatString: General Date
		lineageTag: 5e6001d4-1fc5-4f2a-9158-b0293c32a164
