	measure 'Consumo Total Calculado' =
			
			[Consumo Mercado Libre] +
			[Consumo Mercado Regulado] +
			[Consumo Directo] +
			[Consumo Servicios Auxiliares]
		formatString: 0
		lineageTag: 0009643d-b081-4110-92b0-09fa9587148b

	measure '% Consumo' =
			
			DIVIDE(
			    [Consumo Total],
