table Tabla_Medidas
	lineageTag: 929f63c0-5eb9-4958-9a4c-2c35e3514f28

	measure 'Demanda Total' = SUM(Fact_Energia_ESIOS[demanda_real])
		formatString: #,0.00
		lineageTag: 72ee2f63-d644-468d-b084-3d7c8696c052

	measure 'Demanda P1' =
			
			CALCULATE(
			    [Demanda Total],
			    Fact_Energia_ESIOS[Tarifa_Energia] == "P1"
			)
		formatString: 0.00
		lineageTag: 51f0415a-3037-4241-9b88-a8233eed3870

	measure 'Demanda P2' =
			
			CALCULATE(
			    [Demanda Total],
			    Fact_Energia_ESIOS[Tarifa_Energia] == "P2"
			)
		formatString: 0.00
		lineageTag: 908e0a61-db02-4d31-b738-c68c93b63277

	measure 'Demanda P3' =
			
			CALCULATE(
			    [Demanda Total],
			    Fact_Energia_ESIOS[Tarifa_Energia] == "P3"
			)
		formatString: 0.00
		lineageTag: 6f0f702a-3b08-4c0c-918a-852019db2ab5

	measure 'Precio Promedio' = AVERAGE(Fact_Energia_ESIOS[precio_mercado])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 5a6cc350-8c58-4441-bda0-8a05dc8f9dd7

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure 'Precio Promedio P1' =
			
			CALCULATE(
			    [Precio Promedio],
			    Fact_Energia_ESIOS[Tarifa_Energia] == "P1"
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 04f5e268-c4c9-4cb8-8a14-eb0a665a959f

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure 'Precio Promedio P2' =
			
			CALCULATE(
			    [Precio Promedio],
			    Fact_Energia_ESIOS[Tarifa_Energia] == "P2"
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 04b912ca-0cec-4be7-b4d1-fd4a0d79f2b0

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure 'Precio Promedio P3' =
			
			CALCULATE(
			    [Precio Promedio],
			    Fact_Energia_ESIOS[Tarifa_Energia] == "P3"
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 2a6eeeb2-0f56-4d2c-8464-507fa26136f0

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure '% Consumo Valle' =
			
			DIVIDE(
			    [Demanda P3],
			    [Demanda Total],
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 29258858-69b1-4f91-9c77-23c7856baf7f

	measure 'Gen Eolica' = SUM(Fact_Energia_ESIOS[gen_eolica])
		formatString: #,0.0,," MWh"
		lineageTag: faf676da-2427-41c3-8291-c74351ad841b

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Gen Hidraulica' = SUM(Fact_Energia_ESIOS[gen_hidraulica])
		formatString: #,0.0,," MWh"
		lineageTag: a23d4520-de71-49e2-a8d9-9d223b16c7f0

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Gen Solar' = SUM(Fact_Energia_ESIOS[gen_solar])
		formatString: #,0.0,," MWh"
		lineageTag: c6e10ced-6a0a-43b1-8f40-45179eef6d5f

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Gen Nuclear' = SUM(Fact_Energia_ESIOS[gen_nuclear])
		formatString: #,0.0,," MWh"
		lineageTag: ccf07607-ded3-4b4a-83b0-c549018a8b3e

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Gen Termica Renovable' = SUM(Fact_Energia_ESIOS[gen_ciclo_combinado])
		formatString: " #,0.00,,"" M MWh"""
		lineageTag: 99c680b7-146f-4e8a-83d4-52c55609f277

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Demanda Promedio' = AVERAGE(Fact_Energia_ESIOS[demanda_real])
		formatString: 0
		lineageTag: f4411124-22e0-422e-a268-1a783725aae6

	measure 'Generacion Total' = [Gen Eolica] + [Gen Hidraulica] + [Gen Solar] + [Gen Nuclear] + [Gen Termica Renovable]
		formatString: 0
		lineageTag: 54d713cd-350a-4cfb-92a8-5727330ae9cd

	measure 'Consumo Total' = [Demanda Total]
		formatString: #,0
		lineageTag: 05679bbe-5aa9-4b24-a2cc-d62e443da611

	measure 'Ratio Generacion' =
			
			DIVIDE(
			    [Generacion Total],
			    [Consumo Total],
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: b750b30b-9afe-499a-bea9-792812e16bc1

	measure 'Gen Limpia' = [Gen Eolica] + [Gen Hidraulica] + [Gen Solar] + [Gen Nuclear]
		lineageTag: 9ab048b4-2c13-48eb-9320-a17d5ad5c2db

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gen No Limpia' = [Gen Termica Renovable] + [Gen Carbon]
		lineageTag: 7c936d9b-4060-4b22-a265-dd8ec504383b

	measure 'Gen Carbon' = SUM(Fact_Energia_ESIOS[Gen Carbon])
		lineageTag: 312c803c-1e51-4185-8132-52d774fc65b6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Generacion Limpia' =
			
			DIVIDE([Gen Limpia], [Gen Limpia] + [Gen No Limpia], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 9e38b1a8-23d3-4363-b1e0-4bcaac365a60

	measure 'Demanda Programada Total' = SUM(Fact_Energia_ESIOS[demanda_programada_total])
		lineageTag: 4959d28d-5fb3-44a5-8016-3cc0851bb5cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variacion Demanda %' =
			
			DIVIDE(
			    [Demanda Total] - [Demanda Programada Total Final],
			    [Demanda Programada Total Final],
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 1d92d757-8169-4fab-9e74-dfc955e40215

	measure 'Demanda Programada' = SUM(Fact_Energia_ESIOS[demanda_programada])
		lineageTag: c718bc97-c552-4aee-9d34-5971f5fa1f98

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Demanda Prevista' = SUM(Fact_Energia_ESIOS[demanda_prevista])
		lineageTag: ed183378-fdc7-4332-a692-e9075e7b47f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Demanda Programada Total Final' =
			
			IF(
			    ISBLANK([Demanda Programada Total]),
			    [Demanda Programada],
			    [Demanda Programada Total]
			)
		lineageTag: 0d17f76a-ebeb-4db3-b9fc-06b0da78a51a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Desviacion Absoluta MW' = [Demanda Total] - [Demanda Programada Total Final]
		lineageTag: a1c4301d-acfa-4b12-81e3-0c89a2051973

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition Tabla_Medidas = m
