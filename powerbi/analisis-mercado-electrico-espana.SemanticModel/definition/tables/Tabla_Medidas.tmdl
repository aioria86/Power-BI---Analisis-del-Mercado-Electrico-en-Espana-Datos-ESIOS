table Tabla_Medidas
	lineageTag: 929f63c0-5eb9-4958-9a4c-2c35e3514f28

	measure 'Demanda Total' = SUM(Fact_Energia_ESIOS[demanda_real])
		formatString: #,0.00
		lineageTag: 72ee2f63-d644-468d-b084-3d7c8696c052

	measure 'Demanda P1' =
			
			CALCULATE(
			    [Demanda Total],
			    Fact_Energia_ESIOS[Tarifa_Energia] == "P1"
			)
		formatString: 0.00
		lineageTag: 51f0415a-3037-4241-9b88-a8233eed3870

	measure 'Demanda P2' =
			
			CALCULATE(
			    [Demanda Total],
			    Fact_Energia_ESIOS[Tarifa_Energia] == "P2"
			)
		formatString: 0.00
		lineageTag: 908e0a61-db02-4d31-b738-c68c93b63277

	measure 'Demanda P3' =
			
			CALCULATE(
			    [Demanda Total],
			    Fact_Energia_ESIOS[Tarifa_Energia] == "P3"
			)
		formatString: 0.00
		lineageTag: 6f0f702a-3b08-4c0c-918a-852019db2ab5

	measure 'Precio Promedio' = AVERAGE(Fact_Energia_ESIOS[precio_mercado])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 5a6cc350-8c58-4441-bda0-8a05dc8f9dd7

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure 'Precio Promedio P1' =
			
			CALCULATE(
			    [Precio Promedio],
			    Fact_Energia_ESIOS[Tarifa_Energia] == "P1"
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 04f5e268-c4c9-4cb8-8a14-eb0a665a959f

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure 'Precio Promedio P2' =
			
			CALCULATE(
			    [Precio Promedio],
			    Fact_Energia_ESIOS[Tarifa_Energia] == "P2"
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 04b912ca-0cec-4be7-b4d1-fd4a0d79f2b0

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure 'Precio Promedio P3' =
			
			CALCULATE(
			    [Precio Promedio],
			    Fact_Energia_ESIOS[Tarifa_Energia] == "P3"
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 2a6eeeb2-0f56-4d2c-8464-507fa26136f0

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure '% Consumo Valle' =
			
			DIVIDE(
			    [Demanda P3],
			    [Demanda Total],
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 29258858-69b1-4f91-9c77-23c7856baf7f

	measure 'Gen Eolica' = SUM(Fact_Energia_ESIOS[gen_eolica])
		formatString: 0.00
		lineageTag: faf676da-2427-41c3-8291-c74351ad841b

	measure 'Gen Hidraulica' = SUM(Fact_Energia_ESIOS[gen_hidraulica])
		formatString: 0.00
		lineageTag: a23d4520-de71-49e2-a8d9-9d223b16c7f0

	measure 'Gen Solar' = SUM(Fact_Energia_ESIOS[gen_solar])
		formatString: 0.00
		lineageTag: c6e10ced-6a0a-43b1-8f40-45179eef6d5f

	measure 'Gen Nuclear' = SUM(Fact_Energia_ESIOS[gen_nuclear])
		formatString: 0.00
		lineageTag: ccf07607-ded3-4b4a-83b0-c549018a8b3e

	measure 'Gen Ciclo Combinado' = SUM(Fact_Energia_ESIOS[gen_ciclo_combinado])
		formatString: 0.00
		lineageTag: 99c680b7-146f-4e8a-83d4-52c55609f277

	measure 'Demanda Promedio' = AVERAGE(Fact_Energia_ESIOS[demanda_real])
		formatString: 0
		lineageTag: f4411124-22e0-422e-a268-1a783725aae6

	measure 'Generacion Total' = [Gen Eolica] + [Gen Hidraulica] + [Gen Solar] + [Gen Nuclear] + [Gen Ciclo Combinado]
		formatString: 0
		lineageTag: 54d713cd-350a-4cfb-92a8-5727330ae9cd

	measure 'Consumo Total' = [Demanda Total]
		formatString: #,0
		lineageTag: 05679bbe-5aa9-4b24-a2cc-d62e443da611

	measure 'Ratio Generacion' =
			
			DIVIDE(
			    [Generacion Total],
			    [Consumo Total],
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: b750b30b-9afe-499a-bea9-792812e16bc1

	measure 'Gen Limpia' = [Gen Eolica] + [Gen Hidraulica] + [Gen Solar] + [Gen Nuclear]
		lineageTag: 9ab048b4-2c13-48eb-9320-a17d5ad5c2db

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gen No Limpia' = [Gen Ciclo Combinado] + [Gen Carbon]
		lineageTag: 7c936d9b-4060-4b22-a265-dd8ec504383b

	measure 'Gen Carbon' = SUM(Fact_Energia_ESIOS[Gen Carbon])
		formatString: 0.00
		lineageTag: 312c803c-1e51-4185-8132-52d774fc65b6

	measure '% Generacion Limpia' =
			
			DIVIDE([Gen Limpia], [Gen Limpia] + [Gen No Limpia], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 9e38b1a8-23d3-4363-b1e0-4bcaac365a60

	measure 'Demanda Programada Total' = SUM(Fact_Energia_ESIOS[demanda_programada_total])
		lineageTag: 4959d28d-5fb3-44a5-8016-3cc0851bb5cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variacion Demanda %' =
			
			DIVIDE(
			    [Demanda Total] - [Demanda Programada Total Final],
			    [Demanda Programada Total Final],
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 1d92d757-8169-4fab-9e74-dfc955e40215

	measure 'Demanda Programada' = SUM(Fact_Energia_ESIOS[demanda_programada])
		lineageTag: c718bc97-c552-4aee-9d34-5971f5fa1f98

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Demanda Prevista' = SUM(Fact_Energia_ESIOS[demanda_prevista])
		lineageTag: ed183378-fdc7-4332-a692-e9075e7b47f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Demanda Programada Total Final' =
			
			IF(
			    ISBLANK([Demanda Programada Total]),
			    [Demanda Programada],
			    [Demanda Programada Total]
			)
		lineageTag: 0d17f76a-ebeb-4db3-b9fc-06b0da78a51a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Desviacion Absoluta MW' = [Demanda Total] - [Demanda Programada Total Final]
		lineageTag: a1c4301d-acfa-4b12-81e3-0c89a2051973

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Alerta Demanda' =
			
			SWITCH(
			    TRUE(),
			    [Variacion Demanda %] > 0.02, "Alta (sobreconsumo)",
			    [Variacion Demanda %] < -0.02, "Baja (subconsumo)",
			    "Normal"
			)
		lineageTag: 6431c131-be08-46d7-8448-738e2861c906

	measure 'Banda Superior' = [Demanda Programada Total Final] * 1.02
		lineageTag: 4e6260d0-8704-491e-b3ca-d9c5a56b0ec3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Banda Inferior' = [Demanda Programada Total Final] * 0.98
		lineageTag: e7f99dc1-c026-4426-bb81-682055e7ca0d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Insight Demanda' = ```
			
			SWITCH(
			    TRUE(),
			    [Variacion Demanda %] > 0.02, 
			        "Demanda superior a la prevista (+ desviación)",
			    
			    [Variacion Demanda %] < -0.02, 
			        "Demanda inferior a la prevista (- desviación)",
			    
			    "Demanda alineada con la planificación"
			)
			```
		lineageTag: 15049c69-a6c0-485e-b00f-714cf6c88170

	measure 'Insight Avanzado' =
			
			"En " & FORMAT(MAX(Dim_Calendario[fecha]), "dddd, dd MMMM") &
			": " &
			[Insight Demanda]
		lineageTag: e2e44bb9-179c-4b0d-aef9-f5a697d6f2f9

	measure 'Potencia Disponible' =
			
			COALESCE(SUM(Fact_Energia_ESIOS[pot_disp_nuclear]),0) +
			COALESCE(SUM(Fact_Energia_ESIOS[pot_disp_carbon]),0) +
			COALESCE(SUM(Fact_Energia_ESIOS[pot_disp_fuel]),0) +
			COALESCE(SUM(Fact_Energia_ESIOS[pot_disp_gas]),0) +
			COALESCE(SUM(Fact_Energia_ESIOS[pot_disp_hidraulica]),0)
		formatString: 0
		lineageTag: 8a7b6ef8-94a0-4502-9ff2-75692be9b1b5

	measure 'Potencia Instalada' =
			
			COALESCE(SUM(Fact_Energia_ESIOS[pot_inst_nuclear]),0) +
			COALESCE(SUM(Fact_Energia_ESIOS[pot_inst_carbon]),0) +
			COALESCE(SUM(Fact_Energia_ESIOS[pot_inst_ciclo_combinado]),0)
		formatString: 0
		lineageTag: 1c9f51fa-0942-4f0a-918b-cfa94aff7a3e

	measure 'Potencia Indisponible' = SUM(Fact_Energia_ESIOS[pot_indisponible])
		formatString: 0
		lineageTag: 3fef082f-ce27-4a1c-b118-b021587ce9f7

	measure 'Potencia Instalada Ajustada' = [Potencia Disponible] + [Potencia Indisponible]
		lineageTag: 0205ec78-aa71-419c-b5cf-54d4ea7e4fd0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gen Termica Fosil' = SUM(Fact_Energia_ESIOS[gen_gas]) + SUM(Fact_Energia_ESIOS[gen_fuel])
		formatString: 0.00
		lineageTag: 4d52b700-1d93-4967-a77b-87830da7cf29

	measure 'Almacenamiento Neto' = [Turbinacion Bombeo] - ABS([Consumo Bombeo])
		formatString: 0
		lineageTag: 92eaf653-7554-45bf-a583-aae5b4972f03

	measure '% Almacenamiento' =
			
			DIVIDE(
			    [Almacenamiento Neto],
			    [Demanda Total],
			    0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 0bf6fba6-5a9e-4a83-8a19-2eaf044ca0d9

	measure 'Turbinacion Bombeo' = SUM(Fact_Energia_ESIOS[bombeo_turbinacion])
		formatString: 0
		lineageTag: f6c1fa51-853a-4285-a63c-3003646e55d0

	measure 'Consumo Bombeo' = SUM(Fact_Energia_ESIOS[bombeo_consumo])
		formatString: 0
		lineageTag: 5c87c919-3647-4f00-a8e3-1a593ecb7991

	measure 'Valor Almacenamiento' =
			
			SWITCH(
			    SELECTEDVALUE(Tabla_Almacenamiento[Tipo]),
			    "Turbinación Bombeo", [Turbinacion Bombeo],
			    "Consumo Bombeo", [Consumo Bombeo]
			)
		lineageTag: ee423865-b264-4b94-8134-8cbe0a8e6bd3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition Tabla_Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

